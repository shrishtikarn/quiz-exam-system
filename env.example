# Settings for running QuizHall on your own computer.
# Copy this file to .env, then change DB_PASSWORD to your MySQL root password.
# .env is ignored by Git, so your password is never uploaded.

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=quizexam

# Any long random text. It signs login sessions.
JWT_SECRET=replace-this-with-a-long-random-sentence-1234567890

# Creates tables, the question bank and demo accounts on the first start.
SEED_ON_BOOT=true
# Password for tutor@demo.quiz, parent@demo.quiz and student001@demo.quiz onwards.
DEMO_PASSWORD=demo12345
DEMO_STUDENTS=10
